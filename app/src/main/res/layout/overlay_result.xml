
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_background"
    android:elevation="20dp"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/overlayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚗 VALE CORRIDA PRO"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/decisionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:text="✓ COMPENSA"
        android:textColor="#8DE7B0"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#203B31"
            android:padding="6dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VALOR DA CORRIDA"
                android:textColor="#B7DCC8"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/offerPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 25,00"
                android:textColor="#8DE7B0"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="#252F43"
            android:padding="6dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VALOR POR KM"
                android:textColor="#B9C8E2"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/valuePerKmText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 2,18"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/totalKmText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="11,1 km"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/passengerRatingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⭐ 4,92"
            android:textColor="#FFD580"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/detailsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="Busca: 2,4 km"
        android:textColor="#CBD5E1"
        android:textSize="10sp" />

    <LinearLayout
        android:id="@+id/overlayActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/acceptRideButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="1dp"
            android:backgroundTint="#16834A"
            android:text="ACEITAR"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/rejectRideButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="1dp"
            android:backgroundTint="#8D343A"
            android:text="RECUSAR"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/ignoreRideButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="1dp"
            android:backgroundTint="#465166"
            android:text="IGNORAR"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
